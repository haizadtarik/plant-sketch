OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
NEXT_PUBLIC_FUXA_URL=http://localhost:1881/editor

# Optional local OpenAI computer-use worker (run separately from Next.js).
FUXA_AGENT_URL=http://127.0.0.1:1882
# Generate a private token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the same token in the app's export panel; never prefix it NEXT_PUBLIC_.
FUXA_AGENT_TOKEN=
FUXA_AGENT_FUXA_URL=http://127.0.0.1:1881
OPENAI_COMPUTER_MODEL=gpt-6.1-sol
# Optional installed Chromium executable; otherwise use npx playwright install chromium.
FUXA_AGENT_BROWSER_PATH=
