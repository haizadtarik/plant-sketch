{
  "name": "plantsketch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node --import tsx scripts/fixtures.ts",
    "fuxa:agent": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/fuxa-agent.ts",
    "verify:fuxa-agent": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/verify-fuxa-agent.ts",
    "predev": "node scripts/sync-assets.mjs",
    "prebuild": "node scripts/sync-assets.mjs",
    "format": "prettier --write app components lib tests scripts *.ts *.mjs *.json"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "openai": "^6.49.0",
    "playwright": "1.63.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "micromatch": "^4.0.8",
    "braces": "^3.0.3"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
